# ============================================================
# LOCAL DEVELOPMENT — safe defaults, no real external providers contacted.
# This entire file, as checked into version control, is a LOCAL DEVELOPMENT
# configuration. Nothing below requires a real account until you explicitly
# add credentials. See /admin/integrations (Module 29) in the running app
# for a live view of what's configured vs. missing vs. tested.
# ============================================================

# Database (MySQL preferred; swap provider in prisma/schema.prisma for postgresql)
DATABASE_URL="mysql://user:password@localhost:3306/kutir_home_decor"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REMEMBER_EXPIRES_IN="30d"
AUTH_COOKIE_NAME="kutir_session"

# ============================================================
# TEST/SANDBOX or PRODUCTION — Razorpay. Leave blank for local development
# (checkout/refunds will fail loudly, never silently). Paste Razorpay TEST
# keys here to activate Razorpay in test mode, or LIVE keys to go live —
# this codebase has no separate mock mode for payments; whichever key pair
# you paste in is what gets called, immediately.
# ============================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# Shipment webhook (Module 23) — signs/verifies OUR OWN local mock shipment
# webhook (src/app/api/webhooks/shipment/route.ts + scripts/simulate-shipment.ts).
# NOT a Shiprocket credential — generate any random local value for dev use,
# same convention as RAZORPAY_WEBHOOK_SECRET above.
SHIPMENT_WEBHOOK_SECRET=""

# ============================================================
# TEST/SANDBOX or PRODUCTION — Shiprocket. Shiprocket does not offer a
# separate sandbox; SHIPROCKET_EMAIL/PASSWORD below are always your real
# account credentials, so treat them as production-sensitive even while
# testing.
# ============================================================

# Order-fulfillment shipping provider (Module 27) — "mock" (default, safe
# for local dev, no network calls) or "shiprocket" (requires the two
# credentials below). Unknown value or missing Shiprocket credentials fails
# loudly at request time — never silently falls back to mock.
SHIPPING_PROVIDER="mock"

# Shiprocket (Module 27) — confirmed against Shiprocket's own
# support.shiprocket.in API helpsheet: POST /v1/external/auth/login takes
# {email, password}. This IS your Shiprocket account's API-user email/
# password (create a dedicated API user in the Shiprocket dashboard rather
# than reusing your login — Shiprocket supports up to 4 API users/account).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Reserved, not yet consumed by any code. Shiprocket's dashboard (Settings >
# API > Webhook) does have a "Webhook Secret" field, confirming a webhook
# system exists, but its payload structure and signature-verification
# mechanism are not publicly documented (Shiprocket shares that contract
# privately, per-account, during onboarding) — see shiprocket-provider.ts's
# header comment. Do not wire this into signature verification until that
# contract is confirmed from your own account/onboarding.
# SHIPROCKET_WEBHOOK_SECRET=""

# ============================================================
# TEST/SANDBOX or PRODUCTION — Email & WhatsApp. Only the "console" value
# is implemented on either selector today (prints to the server log instead
# of sending). The commented-out credential variables below are placeholders
# for whenever a real provider is implemented — see /admin/integrations for
# exactly what that would require.
# ============================================================

# Email provider selector (Module 23) — only "console" (or unset) is
# implemented today; see src/lib/services/notifications/providers/index.ts.
# Any other value is a configuration error, not a silent fallback.
EMAIL_PROVIDER="console"
# EMAIL_API_KEY="" — placeholder only, no real provider (Resend/SES/SendGrid/SMTP) implemented yet.

# WhatsApp provider selector (Module 23) — same "console only, for now" rule as EMAIL_PROVIDER above.
WHATSAPP_PROVIDER="console"
# WHATSAPP_ACCESS_TOKEN="" — placeholder only, no real provider (Meta Cloud API/Twilio) implemented yet.
# WHATSAPP_PHONE_NUMBER_ID="" — placeholder only, same caveat.

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Kutir"

# Search-console ownership verification (Module 33) — optional. Paste the
# real verification code Google Search Console / Bing Webmaster Tools gives
# you for the "HTML tag" verification method; leave unset to omit the tag
# entirely (no placeholder is ever emitted).
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""
